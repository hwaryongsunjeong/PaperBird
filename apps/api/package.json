{
  "name": "@paperbird/api",
  "version": "0.0.1",
  "description": "PaperBird 백엔드 — NestJS 비즈니스 로직",
  "private": true,
  "type": "module",
  "scripts": {
    "deps:build": "pnpm --filter @paperbird/schemas build",
    "dev": "pnpm deps:build && nest start --watch",
    "build": "pnpm deps:build && nest build",
    "start": "pnpm deps:build && nest start",
    "start:prod": "node dist/main",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "oxlint --type-aware --deny-warnings src/",
    "typecheck": "pnpm deps:build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm deps:build && vitest run",
    "test:watch": "pnpm deps:build && vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@paperbird/schemas": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
